# Shared look for every swale recording.
# Sourced by the other tapes so they cannot drift apart.

Require swale

Set Shell "bash"
Set FontSize 14
Set Width 1180
Set Height 880
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Margin 14
Set MarginFill "#11111b"
Set BorderRadius 10
