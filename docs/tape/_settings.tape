# Shared look for every swale recording.
# Sourced by the other tapes so they cannot drift apart.

Require swale

Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 560
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Margin 12
Set MarginFill "#1e1e2e"
Set BorderRadius 10
