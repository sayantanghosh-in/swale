{
  "name": "@itssayantan/swale",
  "version": "0.2.0",
  "description": "A local-first developer assistant for your terminal \u2014 tasks, notes, spending, GitHub and LeetCode, with a local or hosted LLM.",
  "keywords": [
    "swale",
    "cli",
    "developer-tools",
    "local-first",
    "terminal",
    "todo",
    "notes",
    "expenses",
    "github",
    "leetcode",
    "ai",
    "llm",
    "ollama",
    "vercel-ai-sdk",
    "sqlite"
  ],
  "homepage": "https://github.com/sayantanghosh-in/swale#readme",
  "bugs": {
    "url": "https://github.com/sayantanghosh-in/swale/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayantanghosh-in/swale.git"
  },
  "license": "MIT",
  "author": "Sayantan Ghosh <sayantan.ghosh03@gmail.com> (https://sayantanghosh.in)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "swale": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/provider": "^4.0.18",
    "@inquirer/prompts": "^8.6.0",
    "@octokit/auth-oauth-device": "^8.0.5",
    "ai": "^7.0.65",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "octokit": "^5.0.5",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/types": "^18.0.0",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
